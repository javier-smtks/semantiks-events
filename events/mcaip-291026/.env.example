# Required: OpenAI with access to gpt-6.1-sol (the computer-use model).
OPENAI_API_KEY=

# Optional: LangSmith trace. Highly recommended — every step and screenshot
# shows up in your LangSmith project.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=semantiks-cua

# Optional: PostHog event capture. Each task-start / cua-action / task-end
# fires as an event you can query / build funnels against. NOT DOM session
# replay — PostHog is the wrong tool for that; use the local screenshot
# trail in `traces/` instead.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Optional: override the model used by the deepagents planner (defaults to
# gpt-6.1-sol). Both the planner and the inner computer-use loop default
# here, so a single OpenAI key with gpt-6.1-sol access is enough.
# AGENT_MODEL=gpt-6.1-sol

# Optional: override the computer-use model id (defaults to gpt-6.1-sol).
# CUA_MODEL=gpt-6.1-sol
